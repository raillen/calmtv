#!/bin/sh
set -eu

output_dir="${1:-build/target-preflight}"
mkdir -p "$output_dir"

command_version() {
	command_name=$1
	if command -v "$command_name" >/dev/null 2>&1; then
		command -v "$command_name"
	else
		printf '%s\n' unavailable
	fi
}

package_status() {
	package_name=$1
	if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W -f='${Status}' "$package_name" 2>/dev/null | grep -q 'install ok installed'; then
		printf '%s\n' installed
	else
		printf '%s\n' unavailable
	fi
}

{
	printf 'timestamp=%s\n' "$(date -Is)"
	printf 'architecture=%s\n' "$(uname -m)"
	printf 'kernel=%s\n' "$(uname -sr)"
	printf 'debian=%s\n' "$(cat /etc/debian_version 2>/dev/null || printf unavailable)"
	printf 'dpkg_architecture=%s\n' "$(dpkg --print-architecture 2>/dev/null || printf unavailable)"
	printf 'ram_kib=%s\n' "$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || printf unavailable)"
	printf 'cpu=%s\n' "$(nproc 2>/dev/null || printf unavailable)"
	printf 'display=%s\n' "${DISPLAY:-unset}"
	printf 'display_manager=%s\n' "$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || printf unavailable)")"
	printf 'systemd=%s\n' "$(command_version systemctl)"
	printf 'xorg=%s\n' "$(command_version Xorg)"
	printf 'matchbox=%s\n' "$(command_version matchbox-window-manager)"
	printf 'mpv=%s\n' "$(command_version mpv)"
	printf 'xrandr=%s\n' "$(command_version xrandr)"
	printf 'vainfo=%s\n' "$(command_version vainfo)"
	printf 'zramctl=%s\n' "$(command_version zramctl)"
	printf 'network_manager=%s\n' "$(package_status network-manager)"
	printf 'bluez=%s\n' "$(package_status bluez)"
	printf 'pipewire=%s\n' "$(package_status pipewire)"
	printf 'wireplumber=%s\n' "$(package_status wireplumber)"
	printf 'gtk3=%s\n' "$(package_status libgtk-3-0)"
	printf 'tv_shell_session=%s\n' "$(test -f /usr/share/xsessions/tv-shell.desktop && printf installed || printf unavailable)"
	printf 'zram_active=%s\n' "$(zramctl 2>/dev/null | sed -n '2p' || printf unavailable)"
} > "$output_dir/environment.txt"

if command -v systemd-analyze >/dev/null 2>&1; then
	systemd-analyze time > "$output_dir/boot.txt" 2>&1 || true
fi

printf '%s\n' "Target preflight written to $output_dir"
